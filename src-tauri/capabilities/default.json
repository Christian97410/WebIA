{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema/capabilities.json",
  "identifier": "default",
  "description": "Default capabilities for WebIA",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "shell:allow-spawn",
    "shell:allow-execute",
    "shell:allow-open",
    "shell:allow-stdin-write",
    "process:allow-exit",
    "process:allow-restart",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-stat",
    "fs:allow-read-dir",
    "updater:default"
  ]
}
